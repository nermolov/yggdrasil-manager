# Pinned dependency versions for reproducible builds
SUBDUCTION_SHA="b8339b6a34e6a62f8f55d0584c0de4466988648c"  # latest main 2026-05-30
WASMTIME_TAG="v33.0.0"        # Wasmtime release with Pulley + wasi-sockets
WASM3_SHA="79d412ea5fcf92f0efe658d52827a0e0a96ff442"  # latest main 2026-05-30
WAMR_TAG="WAMR-2.2.0"        # WAMR release with interp + C API
WASMEDGE_TAG="0.14.1"         # WasmEdge release with interp mode
TOYWASM_SHA="cf2d3b0200b62d32848b71f9c66f044f8faba532"  # latest main 2026-05-30
WAZERO_VER="v1.8.2"           # wazero Go module version
RUST_TOOLCHAIN="1.87.0"       # Rust toolchain (must support wasm32-wasip1/wasip2)

# Build directories (relative to the script's parent dir)
CACHE_DIR=".cache"
BIN_DIR=".cache/bin"
RUNTIMES_DIR=".cache/runtimes"
SUBDUCTION_DIR=".cache/subduction"
